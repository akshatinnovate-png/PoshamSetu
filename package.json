{
  "name": "poshansetu",
  "productName": "PoshanSetu",
  "version": "1.0.1",
  "description": "PoshanSetu — early-warning, consent and continuity layer for the Poshan Tracker (Round 2 prototype)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.mjs",
    "test": "node --test",
    "build:who": "node scripts/build-who.mjs",
    "dist:win": "electron-packager . PoshanSetu --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/test --ignore=^/docs --ignore=^/scripts --ignore=^/dist --ignore=node_modules/@fontsource --ignore=node_modules/esbuild --ignore=node_modules/@esbuild --ignore=node_modules/qrcode --ignore=node_modules/typescript",
    "dist:linux": "electron-packager . PoshanSetu --platform=linux --arch=x64 --out=dist --overwrite --ignore=^/test --ignore=^/docs --ignore=^/scripts --ignore=^/dist --ignore=node_modules/@fontsource --ignore=node_modules/esbuild --ignore=node_modules/@esbuild --ignore=node_modules/qrcode --ignore=node_modules/typescript",
    "dist:mac": "electron-packager . PoshanSetu --platform=darwin --arch=arm64,x64 --out=dist --overwrite --ignore=^/test --ignore=^/docs --ignore=^/scripts --ignore=^/dist --ignore=node_modules/@fontsource --ignore=node_modules/esbuild --ignore=node_modules/@esbuild --ignore=node_modules/qrcode --ignore=node_modules/typescript",
    "check": "node --test && node scripts/sim-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "service": "node server/index.mjs",
    "bench": "node scripts/scale-bench.mjs 1 4 10",
    "build:tradeoff": "node scripts/build-tradeoff.mjs",
    "pwa": "node server/index.mjs",
    "typecheck": "tsc -p jsconfig.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-ol-chiki": "^5.3.0",
    "@fontsource/noto-sans-warang-citi": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "author": "Team 7, Gulmohur High School, Jamshedpur"
}
